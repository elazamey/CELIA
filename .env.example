# CELIA × Orca Environment Template
# انسخ هذا الملف إلى .env وسيقوم Orca بنقله تلقائياً لكل Worktree جديد عبر .worktreeinclude

# CELIA Hub Server
PORT=4173
HOST=0.0.0.0

# Celia AI Assistant (Groq primary + Gemini fallback)
