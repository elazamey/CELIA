# No API keys are required. Copy to .env and adjust for your machine.
HOST=0.0.0.0
PORT=3000
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=120000
NEW1_MAX_STEPS=10
NEW1_MAX_CONCURRENCY=2
NEW1_COMMAND_TIMEOUT_MS=120000
