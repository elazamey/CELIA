{
  "name": "celia-fashion-orca",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CELIA Fashion Wear — Multi-Agent AI Orchestration Hub powered by stablyai/orca",
  "repository": {
    "type": "git",
    "url": "https://github.com/elazamey/CELIA.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node hub/server.mjs",
    "hub": "node hub/server.mjs",
    "doctor": "bash scripts/celia-doctor.sh",
