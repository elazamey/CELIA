    "status": "node scripts/celia-orchestrator.mjs status",
    "plan": "node scripts/celia-orchestrator.mjs plan",
    "automations": "node scripts/celia-orchestrator.mjs automations",
    "sync:orca": "bash scripts/orca-sync.sh status",
    "init:orca": "bash scripts/orca-sync.sh init",
    "skills:orca": "bash scripts/orca-sync.sh install-skills",
    "test": "node --test tests/*.test.mjs"
